# Aplicacao
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1
LOG_LEVEL=info

# PostgreSQL
POSTGRES_DB=estoque_revisao
POSTGRES_USER=estoque_revisao_app
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_PORT=5432
DATABASE_URL=postgresql://estoque_revisao_app:troque_esta_senha@localhost:5432/estoque_revisao
DATABASE_SSL=false

# Banco isolado usado somente pelos testes de integracao
TEST_DATABASE_URL=postgresql://estoque_revisao_app:troque_esta_senha@localhost:5432/estoque_revisao_test

# Autenticacao (gere valores longos e aleatorios fora do repositorio)
JWT_ACCESS_SECRET=substitua-por-um-segredo-com-no-minimo-32-caracteres
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
AUTH_COOKIE_SECURE=false

# Argon2id - ajuste apos medir o ambiente produtivo
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Armazenamento futuro de anexos
FILE_STORAGE_PATH=./storage

# Bootstrap local opcional (usado somente por `npm run db:user:create`)
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=substitua-por-uma-senha-forte
BOOTSTRAP_ROLE_CODE=ADMIN
